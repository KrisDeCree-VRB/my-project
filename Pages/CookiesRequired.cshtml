@page
@{
    ViewData["Title"] = "Cookies required";
    ViewData["NoIndex"] = true;
}

@* EC-5: a plain explanation, rather than a failure that could be mistaken for a
   successful join. *@
<h1 class="h3">This trip needs cookies</h1>
<p>
    There are no accounts here — a cookie is the only way your browser can remember who
    you are in a trip. Allow cookies for this site and open your invite link again.
</p>
